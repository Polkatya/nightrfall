# Supabase project settings — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, NEVER expose to the client/browser.
# Used only in app/api routes for privileged admin actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram moderation bot — new profiles are sent here for approve/reject
# before they go live. See README for setup steps.
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-telegram-chat-id
TELEGRAM_WEBHOOK_SECRET=any-random-string-you-choose

# Your deployed site URL, used to build the "View on site" link in the
# Telegram moderation message. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
